{
  "name": "flowdesk",
  "version": "1.0.0",
  "description": "Local-first AI creator workstation for prompts, AI tools, social workflows, and multi-account sessions",
  "main": "./out/main/main.js",
  "type": "module",
  "author": "FlowDesk",
  "license": "MIT",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:debug": "set ELECTRON_ENABLE_LOGGING=1&& set ELECTRON_ENABLE_STACK_DUMPING=1&& set FLOWDESK_VOICE_DEBUG=1&& set FLOWDESK_AGENT_DEBUG=1&& set DEBUG=electron-vite:*&& electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "com.flowdesk.app",
    "productName": "FlowDesk",
    "copyright": "Copyright (c) 2025 FlowDesk",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "node_modules/@anthropic-ai/**/*",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/@openai/**/*"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-win32-x64/**",
      "node_modules/@openai/codex-win32-x64/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@openai/codex-win32-x64/vendor",
        "to": "codex/vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraMetadata": {
      "main": "./out/main/main.js"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlowDesk Retro Workstation",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "installerSidebar": "resources/installerSidebar.bmp",
      "installerHeader": "resources/installerHeader.bmp",
      "include": "resources/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.221",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@google/genai": "^2.18.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.148.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-store": "^8.2.0",
    "livekit-client": "^2.22.0",
    "livekit-server-sdk": "^2.18.0",
    "lucide-react": "^0.344.0",
    "onnxruntime-web": "^1.29.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.1",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
