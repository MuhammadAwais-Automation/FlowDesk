{
  "name": "flowdesk",
  "version": "1.0.0",
  "description": "Local-first AI creator workstation for prompts, AI tools, social workflows, and multi-account sessions",
  "main": "./out/main/main.js",
  "type": "module",
  "author": "FlowDesk",
  "license": "MIT",
  "bin": {
    "flowdesk": "./bin/flowdesk-cli.mjs",
    "flowdesk-mcp": "./bin/flowdesk-mcp.mjs"
  },
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:headless": "electron-vite dev -- --hidden",
    "dev:debug": "set ELECTRON_ENABLE_LOGGING=1&& set ELECTRON_ENABLE_STACK_DUMPING=1&& set FLOWDESK_VOICE_DEBUG=1&& set FLOWDESK_AGENT_DEBUG=1&& set DEBUG=electron-vite:*&& electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "cli": "node ./bin/flowdesk-cli.mjs",
    "mcp": "node ./bin/flowdesk-mcp.mjs",
    "fonts:build": "node scripts/build-font-catalogue.mjs"
  },
  "build": {
    "appId": "com.flowdesk.app",
    "productName": "FlowDesk",
    "copyright": "Copyright (c) 2025 FlowDesk",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "!out/**/*.map",
      "node_modules/@modelcontextprotocol/**/*",
      "node_modules/@huggingface/transformers/**/*",
      "node_modules/onnxruntime-common/**/*",
      "node_modules/onnxruntime-node/package.json",
      "node_modules/onnxruntime-node/dist/**/*",
      "node_modules/onnxruntime-node/bin/napi-v6/win32/x64/**/*"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "extraMetadata": {
      "main": "./out/main/main.js"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FlowDesk Retro Workstation",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "installerSidebar": "resources/installerSidebar.bmp",
      "installerHeader": "resources/installerHeader.bmp",
      "include": "resources/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-store": "^8.2.0",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.344.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sigma": "^3.0.3",
    "tailwind-merge": "^2.6.1",
    "tldts": "^7.4.11",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
